{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "picks": {
          "$pickId": {
            ".validate": "newData.hasChildren(['localTeam', 'awayTeam', 'line', 'createdAt'])"
          }
        },
        "bankroll": {
          "balance": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "profile": {
          ".validate": "newData.hasChildren(['username'])"
        }
      }
    },
    "usernamesIndex": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "usernamesByUid": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    ".read":  false,
    ".write": false
  }
}
